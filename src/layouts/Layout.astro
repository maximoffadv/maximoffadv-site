---
export interface Props {
  frontmatter?: {
    title?: string;
    description?: string;
  };
  title?: string;
  description?: string;
}

const { frontmatter, title, description } = Astro.props;
const pageTitle = frontmatter?.title || title || 'Maximoffadv — Off-Road Coaching';
const pageDescription =
  frontmatter?.description ||
  description ||
  'Off-road dual-sport and heavy adventure motorcycle coaching in Bansko, Bulgaria.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <style is:global>
      :root {
        --bg: #f6f5f2;
        --surface: #ffffff;
        --text: #1c1d1f;
        --muted: #52565e;
        --border: #dcd8d0;
        --accent: #9e3b18;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.65;
      }

      .site-header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .nav-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 0.9rem 1.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }

      .brand {
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
        color: var(--text);
        text-transform: uppercase;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.1rem;
      }

      .nav-links a {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
      }

      .nav-links a:hover {
        color: var(--accent);
      }

      .container {
        max-width: 820px;
        margin: 0 auto;
        padding: 2.25rem 1.25rem 4rem;
        background: var(--surface);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
        min-height: calc(100vh - 120px);
      }

      main h1 {
        font-size: clamp(1.75rem, 3.5vw, 2.4rem);
        line-height: 1.2;
        margin-top: 0;
      }

      main h2 {
        font-size: 1.4rem;
        margin-top: 2.2rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid var(--border);
      }

      main h3 {
        font-size: 1.12rem;
        margin-top: 1.5rem;
      }

      main img {
        display: block;
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        margin: 1.25rem 0 0.5rem;
      }

      main blockquote {
        margin: 1.5rem 0;
        padding: 0.9rem 1.15rem;
        background: var(--bg);
        border-left: 4px solid var(--accent);
      }

      main a {
        color: var(--accent);
      }

      main hr {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }

      .site-footer {
        max-width: 960px;
        margin: 0 auto;
        padding: 1.25rem;
        color: var(--muted);
        font-size: 0.875rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-inner">
        <a class="brand" href="/">Maximoffadv</a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/">Home</a>
          <a href="/training-and-rides">Training & Rides</a>
          <a href="/location-and-logistics">Location & Logistics</a>
          <a href="/knowledge">Knowledge</a>
          <a href="/testimonials">Testimonials</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <div class="container">
      <main>
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <span>Maximoffadv · Bansko, Bulgaria</span>
      <span>Rhodope & Rila Mountains</span>
    </footer>
  </body>
</html>